  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.5"
  }
}
