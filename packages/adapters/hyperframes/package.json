{
  "name": "@aiediting/adapter-hyperframes",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aiediting/adapter-sdk": "workspace:*",
    "@aiediting/browser": "workspace:*",
    "@aiediting/media": "workspace:*",
    "hyperframes": "0.9.3",
    "@aiediting/project-schema": "workspace:*"
  }
}
