{
  "name": "@aiediting/adapter-remotion",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aiediting/adapter-sdk": "workspace:*",
    "@aiediting/browser": "workspace:*",
    "@aiediting/media": "workspace:*",
    "@remotion/cli": "4.0.540",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.540",
    "@aiediting/project-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6"
  }
}
